{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerElInventarioDeEC2ySuRed",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeImages",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OperarUnicamenteLasInstanciasEtiquetadasDelGrupo8",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:331725318481:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Proyecto": "practica1-g8"
        }
      }
    }
  ]
}
