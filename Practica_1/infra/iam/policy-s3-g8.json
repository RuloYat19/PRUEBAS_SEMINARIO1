{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerLosNombresDeBucketsParaPoderNavegarLaConsolaS3",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "CrearYConfigurarUnicamenteLosDosBucketsDelGrupo8",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketWebsite",
        "s3:PutBucketWebsite",
        "s3:GetBucketCORS",
        "s3:PutBucketCORS",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::practica1-web-g8",
        "arn:aws:s3:::practica1-images-g8"
      ]
    },
    {
      "Sid": "LeerYEscribirObjetosDentroDeEsosBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::practica1-web-g8/*",
        "arn:aws:s3:::practica1-images-g8/*"
      ]
    }
  ]
}
