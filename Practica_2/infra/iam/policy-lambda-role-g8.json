{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubirArchivosSoloAlBucketDeArchivos",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::practica2semi1b2s2026archivosg8/*"
    },
    {
      "Sid": "EscribirLogsDeLasFunciones",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:237145860265:log-group:/aws/lambda/p2-lambda-*"
    }
  ]
}
