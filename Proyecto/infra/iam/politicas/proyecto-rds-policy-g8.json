{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RDSSoloEnUsEast1",
      "Effect": "Allow",
      "Action": "rds:*",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "VerRedParaElegirSubnetsYSG",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeAccountAttributes"
      ],
      "Resource": "*"
    }
  ]
}
