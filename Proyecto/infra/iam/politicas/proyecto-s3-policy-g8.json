{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketsDelProyecto",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::semi1proyecto-g8-2s2026", "arn:aws:s3:::proyecto-web-g8"]
    },
    {
      "Sid": "ObjetosDelProyecto",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::semi1proyecto-g8-2s2026/*", "arn:aws:s3:::proyecto-web-g8/*"]
    }
  ]
}
