{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EscribirSoloEnLasDosCarpetas",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::semi1proyecto-g8-2s2026/Fotos_Perfil/*",
        "arn:aws:s3:::semi1proyecto-g8-2s2026/Fotos_Publicadas/*"
      ]
    },
    {
      "Sid": "CrearSuGrupoDeLogs",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-1:237145860265:*"
    },
    {
      "Sid": "EscribirSusLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:237145860265:log-group:/aws/lambda/proyecto-lambda-imagenes-g8:*"
    }
  ]
}
